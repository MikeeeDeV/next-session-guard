{
  "name": "next-session-guard",
  "version": "2.0.0",
  "description": "Production-ready multi-device session management, device tracking, geo-detection, and remote session revocation for Next.js & Prisma.",
  "main": "dist/index.js",
  "module": "dist/index.mjs",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.mjs",
      "require": "./dist/index.js"
    },
    "./actions": {
      "types": "./dist/actions.d.ts",
      "import": "./dist/actions.mjs",
      "require": "./dist/actions.js"
    },
    "./cache": {
      "types": "./dist/cache.d.ts",
      "import": "./dist/cache.mjs",
      "require": "./dist/cache.js"
    }
  },
  "files": [
    "dist",
    "prisma/schema.prisma",
    "README.md",
    "LICENSE"
  ],
  "sideEffects": false,
  "repository": {
    "type": "git",
    "url": "https://github.com/your-username/next-session-guard.git"
  },
  "keywords": [
    "nextjs",
    "session",
    "session-management",
    "next-auth",
    "prisma",
    "auth",
    "device-tracking",
    "security",
    "revoke-sessions",
    "authentication",
    "geo-detection",
    "server-actions",
    "redis",
    "upstash",
    "edge"
  ],
  "author": "Mohamed Ayman",
  "license": "MIT",
  "scripts": {
    "build": "tsup",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "prepublishOnly": "npm run build"
  },
  "peerDependencies": {
    "next": ">=14.0.0",
    "react": ">=18.0.0",
    "react-dom": ">=18.0.0",
    "@prisma/client": ">=5.0.0"
  },
  "dependencies": {
    "lucide-react": "^0.475.0"
  },
  "devDependencies": {
    "@prisma/client": "^6.4.0",
    "@types/node": "^20.0.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "next": "^15.0.0",
    "prisma": "^6.4.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "tsup": "^8.0.0",
    "typescript": "^5.0.0",
    "vitest": "^3.0.0"
  }
}
